#!/bin/sh
# radarpi 卸载前：先把服务停下来，避免占用串口和录制文件。
set -e

if command -v systemctl >/dev/null 2>&1 && [ -d /run/systemd/system ]; then
    case "$1" in
    remove|deconfigure)
        systemctl stop radarpi-web.service >/dev/null 2>&1 || true
        systemctl disable radarpi-web.service >/dev/null 2>&1 || true
        ;;
    upgrade|failed-upgrade)
        # 升级时只停不 disable，postinst 会重新拉起来
        systemctl stop radarpi-web.service >/dev/null 2>&1 || true
        ;;
    esac
fi

exit 0
